# ============================================================================
# MAGIC — Production environment variables
# ----------------------------------------------------------------------------
# Copy to .env.prod on the server and fill in REAL values:
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod to git. Generate strong random secrets, e.g.:
#   openssl rand -base64 48
# ============================================================================

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=magicdb
POSTGRES_USER=magicadmin
# Use a long random password (openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ─── Auth / sessions (REQUIRED, min 32 chars each) ───────────────────────────
# openssl rand -base64 48
MAGIC_CUSTOMER_SECRET=CHANGE_ME_jwt_signing_secret
# openssl rand -base64 32
GOTH_SESSION_KEY=CHANGE_ME_session_key

# ─── URLs / CORS ─────────────────────────────────────────────────────────────
# Public URL of the API (behind Cloudflare), e.g. https://api.votredomaine.tn
BASE_URL=https://api.votredomaine.tn
# Public URL of the storefront (Cloudflare Pages), used for OAuth redirects
FRONTEND_URL=https://votredomaine.tn
# Comma-separated allowed origins (storefront + admin). NO trailing slash.
CORS_ALLOWED_ORIGINS=https://votredomaine.tn,https://admin.votredomaine.tn

# ─── Object storage — Cloudflare R2 ──────────────────────────────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_BUCKET=magic-products
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
# Public CDN URL for product images, e.g. https://cdn.votredomaine.tn
R2_PUBLIC_BASE_URL=https://cdn.votredomaine.tn

# ─── Email — Mailjet ─────────────────────────────────────────────────────────
MAILJET_API_KEY_PUBLIC=CHANGE_ME
MAILJET_API_KEY_PRIVATE=CHANGE_ME
MAILJET_FROM_NAME=Magic
MAILJET_FROM_EMAIL=noreply@votredomaine.tn
