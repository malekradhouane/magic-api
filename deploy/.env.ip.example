# ============================================================================
# MAGIC — Variables d'environnement, PHASE IP (test, sans domaine)
# ----------------------------------------------------------------------------
# Copier vers .env.ip sur le serveur :  cp .env.ip.example .env.ip
# Remplace <IP> par l'IP publique de ton VPS Hetzner.
#
# ⚠️ Ne jamais committer .env.ip. Régénère des secrets forts :
#   openssl rand -base64 48
# ============================================================================

# ─── Base de données ─────────────────────────────────────────────────────────
POSTGRES_DB=magicdb
POSTGRES_USER=magicadmin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ─── Auth / sessions ─────────────────────────────────────────────────────────
MAGIC_CUSTOMER_SECRET=CHANGE_ME_jwt_signing_secret
GOTH_SESSION_KEY=CHANGE_ME_session_key

# ─── URLs / CORS (phase IP : HTTP + IP, pas de domaine) ──────────────────────
# Si tu utilises Nginx (port 80) : http://<IP>
# Si tu tapes l'API directement   : http://<IP>:5002
BASE_URL=http://<IP>:5002

# Front lancé en LOCAL sur ton PC pour tester :
FRONTEND_URL=http://localhost:3000

# Origines autorisées (CORS). Ajoute ici :
#  - tes fronts en local (localhost:3000 boutique, localhost:3001 admin)
#  - et/ou tes URLs Netlify si tu déploies les fronts là-bas
# Séparées par des virgules, SANS slash final.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://magic-front.netlify.app,https://magic-admin.netlify.app

# ─── Stockage images — Cloudflare R2 (fonctionne sans domaine) ───────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_BUCKET=magic-products
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
# URL publique R2 (Cloudflare en fournit une par défaut type
# https://pub-xxxxx.r2.dev tant que tu n'as pas de domaine cdn.)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ─── Email — Mailjet ─────────────────────────────────────────────────────────
MAILJET_API_KEY_PUBLIC=CHANGE_ME
MAILJET_API_KEY_PRIVATE=CHANGE_ME
MAILJET_FROM_NAME=Magic
MAILJET_FROM_EMAIL=noreply@example.com
