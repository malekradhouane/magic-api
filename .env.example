# Magic API — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# ─── JWT ──────────────────────────────────────────────
# REQUIRED: secret used to sign JWT tokens (min 32 chars recommended)
MAGIC_CUSTOMER_SECRET=change-me-to-a-strong-random-secret

# ─── Database ─────────────────────────────────────────
POSTGRES_DB=magicdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins (production)
# CORS_ALLOWED_ORIGINS=https://magic.tn,https://admin.magic.tn

# ─── Application ──────────────────────────────────────
MODE=dev
BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000

# ─── S3 / R2 (optional, MinIO defaults for local dev) ─
# S3_ENDPOINT=http://localhost:9100
# S3_BUCKET=magic-products
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ─── MinIO (local dev only) ───────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ─── Email (Mailjet) ─────────────────────────────────
# MAGIC_EMAIL_MAILJET_API_KEY_PUBLIC=
# MAILJET_API_KEY_PRIVATE=
